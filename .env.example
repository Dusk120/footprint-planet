# Docker 部署配置模板：复制为 .env 并填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到 git，真实密钥只保存在部署机本地

# MySQL root 密码（backend 也用同一密码连接数据库）
MYSQL_ROOT_PASSWORD=

# JWT 签名密钥：≥32 字节随机串，用 `openssl rand -base64 48` 生成
FOOTPRINT_JWT_SECRET_KEY=

# 前端访问地址（拼「邀请链接」用），按实际改
FOOTPRINT_FRONTEND_URL=

# 高德 Web 服务 key（可选，不填则「出行方案」算路降级为直线）
FOOTPRINT_AMAP_WEB_KEY=
