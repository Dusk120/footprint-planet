# ========== 本地开发配置：账号密码集中填写处 ==========

# 本文件为 application-dev.yml 的示例文件，包含所有需要配置的项。
# 请复制此文件为 application-dev.yml 并填写实际值。项目默认使用 dev profile 启动。
# 换库 / 部署新环境 / 申请到云账号后，只需改本文件即可。

# ---- 数据库（对应 sql/footprint_planet.sql 建好的库）----
footprint:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: footprint_planet
    username: root
    password: # MySQL密码
  # ---- Redis ----
  redis:
    host: localhost
    port: 6379
    password: # MySQL密码

    # ===== JWT（签名密钥）=====
  jwt:
     # 设置jwt签名加密时使用的秘钥
    secret-key: # 生产环境请使用随机密钥
    # 设置jwt过期时间
    ttl: 7200000
    # 设置前端传递过来的令牌名称
    token-name: Authorization
  # ---- 前端地址（拼邀请链接 link 用）----
  frontend-url: http://localhost:5173
  # ---- 高德地图 ----
  amap:
    # 高德 Web 服务 key（后端算路、绘制真实路线用，注意不是前端「Web 端(JS API)」key）。
    # 申请：高德开放平台 https://lbs.amap.com/ 创建「Web 服务」类型应用，复制 key 填到冒号后。
    # 不填也能启动，只是「出行方案」算路会失败、地图上回退为直线。
    web-key:

# ---- 阿里云 OSS（图片上传用）----
aliyun:
  oss:
    endpoint: oss-cn-hangzhou.aliyuncs.com
    access-key-id: # OSS密钥ID
    access-key-secret: # OSS密钥Secret
    bucket-name:
    url-prefix: # OSS访问域名

